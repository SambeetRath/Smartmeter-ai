# Copy to .env and replace placeholders as needed.
SMARTMETER_DATASET_PATH=./data/raw/household_power_consumption.txt
SMARTMETER_PROCESSED_DATASET_PATH=./data/processed/household_power_consumption.parquet
SMARTMETER_LOG_LEVEL=INFO
SMARTMETER_TIMEZONE=UTC
SMARTMETER_METER_IDENTIFIER=uci_household_1
SMARTMETER_INGESTION_BATCH_SIZE=5000

# Local development placeholders only. Replace before use and never commit .env.
POSTGRES_DB=smartmeter_db
POSTGRES_USER=smartmeter_user
POSTGRES_PASSWORD=CHANGE_ME_LOCAL_ONLY
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://smartmeter_user:CHANGE_ME_LOCAL_ONLY@127.0.0.1:5432/smartmeter_db?connect_timeout=5
